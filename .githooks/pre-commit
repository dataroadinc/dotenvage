#!/bin/sh
# Check for Rust files in commit
RUST_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null) || {
    echo "Error: Failed to get staged files."
    exit 1
}
RUST_FILES=$(echo "$RUST_FILES" | grep '\.rs$' || true)
if [ -z "$RUST_FILES" ]; then
    exit 0
fi

echo "Running the pinned formatter..."
if ! ./scripts/fmt.sh --check; then
    echo "Format check failed. Run: ./scripts/fmt.sh"
    exit 1
fi

echo "Running clippy with the repository toolchain..."
if ! cargo clippy --all-targets -- -D warnings; then
    echo "Clippy check failed."
    exit 1
fi

exit 0
